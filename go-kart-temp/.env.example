# Inbox that receives each pre-registration. Defaults to info@TheApexAsylum.co.uk.
REGISTRATION_TO_EMAIL=info@TheApexAsylum.co.uk

# Sender shown on the email. For Resend this must be a verified domain,
# except onboarding@resend.dev which only delivers to the Resend account owner.
REGISTRATION_FROM_EMAIL=

# Use Resend when this is set. Otherwise SMTP is used.
RESEND_API_KEY=

# SMTP, if you are not using Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
